{
  "name": "fjordborn",
  "productName": "Fjordborn",
  "version": "1.1.0",
  "description": "Fjordborn - a Viking survival saga",
  "author": "Fjordborn",
  "main": "app/main.js",
  "private": true,
  "build": {
    "appId": "com.fjordborn.game",
    "productName": "Fjordborn",
    "copyright": "Fjordborn",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "!app/game/test_*.html",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Fjordborn",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "uninstallDisplayName": "Fjordborn",
      "artifactName": "Fjordborn-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "linux": {
      "target": "dir"
    },
    "afterPack": "build/afterPack.js",
    "publish": [
      {
        "provider": "github",
        "owner": "cdhrnbstl7",
        "repo": "fjordborn",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@fontsource/alegreya-sans": "^5.3.0",
    "@fontsource/grenze-gotisch": "^5.3.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "resedit": "^3.1.1",
    "three": "^0.128.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
